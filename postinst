#!/bin/bash
set -e

# Determine actual user (who ran sudo)
REAL_USER=${SUDO_USER:-$(logname)}
USER_HOME=$(eval echo "~$REAL_USER")
echo "Running setup.sh as $REAL_USER with HOME @ $USER_HOME"

# 1. Install files to home
# Copy files (including hidden files) into the user’s home
SRC_DIR="/usr/share/brent-install/to_home_dir"
DEST_DIR="$USER_HOME"
cp -r "$SRC_DIR"/. "$DEST_DIR"/
# Change ownership of only the files that were just copied
cd "$SRC_DIR"
find . -print0 | while IFS= read -r -d '' path; do
  [ -e "$DEST_DIR/$path" ] && chown -h "$REAL_USER":"$REAL_USER" "$DEST_DIR/$path"
done

# 2. fdfind should be shortened to fd
if [ ! -f "/usr/local/bin/fd" ]; then
  ln -s /usr/bin/fdfind /usr/local/bin/fd
fi

# 3. Install rustup via snap
snap install rustup --classic

# 4. Azure CLI (needed by ~/.gbrain/refresh-*.sh to hydrate secrets from Key
#    Vault). It is NOT installed here: Microsoft's installer runs apt-get, and a
#    postinst runs while the outer apt/dpkg holds the dpkg lock, so the nested
#    apt-get failed with "Could not get lock" and, under `set -e`, left the
#    whole package half-configured (seen on a fresh Ubuntu 26.04 box, where az
#    wasn't already present to skip the step). Point at the helper instead.
if ! command -v az >/dev/null 2>&1; then
  echo "NOTE: Azure CLI not installed. After this install finishes, run:"
  echo "  /usr/share/brent-install/scripts/install-azure-cli.sh"
fi

# 5. gbrain runs as a systemd USER service (gbrain-http.service). Linger keeps
#    the user's systemd manager running without a login session, so the server
#    survives logout and reboot, and setup.sh can drive `systemctl --user`
#    from under sudo. Root-only, so it happens here.
if [ "${INSTALL_GBRAIN:-1}" != 0 ]; then
  if loginctl enable-linger "$REAL_USER"; then
    USER_BUS="/run/user/$(id -u "$REAL_USER")/bus"
    for _ in $(seq 1 15); do [ -S "$USER_BUS" ] && break; sleep 1; done
  else
    echo "WARN: loginctl enable-linger $REAL_USER failed; gbrain-http will only run while you're logged in."
  fi
fi

# 6. Run additional user script; run setup.sh as that user, preserving HOME.
#
# sudo resets the environment, so the gbrain knobs (INSTALL_GBRAIN,
# GBRAIN_MCP_*) never reached setup.sh before — pass them explicitly. The token
# goes via a 0600 file rather than sudo's argv, where `ps` would show it for
# the whole run.
SETUP_ENV=(HOME="$USER_HOME" INSTALL_GBRAIN="${INSTALL_GBRAIN:-1}")
[ -n "${GBRAIN_MCP_MODE:-}" ] && SETUP_ENV+=(GBRAIN_MCP_MODE="$GBRAIN_MCP_MODE")
[ -n "${GBRAIN_MCP_URL:-}" ] && SETUP_ENV+=(GBRAIN_MCP_URL="$GBRAIN_MCP_URL")
if [ -n "${GBRAIN_MCP_TOKEN:-}" ]; then
  TOKEN_FILE=$(mktemp)   # 0600
  trap 'rm -f "$TOKEN_FILE"' EXIT
  printf '%s' "$GBRAIN_MCP_TOKEN" >"$TOKEN_FILE"
  chown "$REAL_USER" "$TOKEN_FILE"
  SETUP_ENV+=(GBRAIN_MCP_TOKEN_FILE="$TOKEN_FILE")
fi
sudo -u "$REAL_USER" "${SETUP_ENV[@]}" bash /usr/share/brent-install/scripts/setup.sh
